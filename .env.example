# No environment variable is REQUIRED. Every setting has a CLI flag and a
# default. This file lists the optional overrides.
#
# The default transport is a local Ollama daemon on 127.0.0.1 with no key and
# no outbound network. Set KIVI_LLM_API_KEY only if you would rather use a
# hosted OpenAI-compatible endpoint than pull a local model.

# --- hosted model (optional alternative to a local Ollama install) -----------
KIVI_LLM_API_KEY=
KIVI_LLM_BASE_URL=https://api.openai.com/v1

# --- backend selection ------------------------------------------------------
# auto = use a model when one is reachable, otherwise fall back (visibly).
KIVI_EXTRACTOR=auto          # rule | llm | hybrid | auto
KIVI_NLI=auto                # off | llm | cross-encoder | auto
KIVI_RETRIEVAL=auto          # lexical | hybrid | auto
KIVI_ANSWERER=auto           # template | llm | auto

# --- local Ollama -----------------------------------------------------------
KIVI_OLLAMA_HOST=http://127.0.0.1:11434
KIVI_LLM_MODEL=qwen2.5:7b-instruct
KIVI_EMBED_MODEL=nomic-embed-text
KIVI_NLI_MODEL=
KIVI_CROSS_ENCODER_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli

# --- generation -------------------------------------------------------------
KIVI_TEMPERATURE=0
KIVI_NUM_CTX=4096
KIVI_REQUEST_TIMEOUT=120

# --- caching ----------------------------------------------------------------
KIVI_USE_CACHE=1
KIVI_CACHE_PATH=data/llm_cache.db
